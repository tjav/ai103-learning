# AI-103 Katas — environment template
# `scripts/01_connect_azure.ps1` generates the real `.env` from this file.
# NEVER commit `.env`. It is git-ignored.
#
# Note: this course uses Microsoft Entra ID (keyless) auth via DefaultAzureCredential
# wherever the service supports it. Keys appear only where a service still requires
# one, and are marked as such.

# --- Subscription / tenant --------------------------------------------------
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-ai103-lab
AZURE_LOCATION=swedencentral

# --- Foundry ----------------------------------------------------------------
AZURE_AI_FOUNDRY_RESOURCE=
AZURE_AI_PROJECT_NAME=ai103-project
# Project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=
# Inference endpoint, e.g. https://<resource>.services.ai.azure.com
AZURE_AI_INFERENCE_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Model deployment names (created by 02_provision_core.ps1) --------------
MODEL_CHAT=gpt-4o
MODEL_MINI=gpt-4o-mini
MODEL_REASONING=o4-mini
MODEL_EMBEDDING=text-embedding-3-small
MODEL_IMAGE=gpt-image-1
MODEL_VIDEO=sora-2

# --- Azure AI Search --------------------------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=ai103-index
AZURE_SEARCH_SERVICE=

# --- Storage ----------------------------------------------------------------
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=ai103-docs
AZURE_STORAGE_BLOB_ENDPOINT=

# --- Foundry Tools (Language, Translator, Speech, Content Understanding) -----
# These share the Foundry (AI Services) multi-service resource endpoint.
AZURE_LANGUAGE_ENDPOINT=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=swedencentral
AZURE_SPEECH_REGION=swedencentral
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_CONTENT_SAFETY_ENDPOINT=

# --- Keys (only where keyless auth is not yet supported) --------------------
# The Speech SDK still commonly uses a key; everything else should use Entra ID.
AZURE_SPEECH_KEY=

# --- Observability ----------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_LOG_ANALYTICS_WORKSPACE=

# --- Cost guard -------------------------------------------------------------
AZURE_BUDGET_NAME=ai103-budget
AZURE_BUDGET_AMOUNT=50
AZURE_BUDGET_ALERT_EMAIL=
